<?xml version="1.0" ?>
<sdf version="1.4">
  <model name="aruco_cube_exam_id63">
    <static>0</static>
    <link name="link">

      <inertial>
        <mass>0.1</mass> <inertia>
          <ixx>0.001</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.001</iyy>
          <iyz>0.0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>

      <collision name="cube_collision">
        <geometry>
          <box>
            <size>0.07 0.07 0.07</size>
          </box>
        </geometry>
      
      <surface>
        <friction>
          <ode>
            <mu>10000</mu> <mu2>10000</mu2>
          </ode>
          <torsional>
            <ode>
              <coefficient>1000.0</coefficient>
              <use_patch_radius>true</use_patch_radius>
              <patch_radius>0.05</patch_radius>
            </ode>
          </torsional>
        </friction>
        <contact>
          <ode>
            <kp>100000.0</kp> <kd>10.0</kd>       
            <max_vel>0.0</max_vel> 
            <min_depth>0.0</min_depth> </ode>
        </contact>
      </surface>

      </collision>

      <!-- Original pick surface visual -->
      <visual name="cube_visual">
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular>
          <emissive>0 0 0 1</emissive>
        </material>
        <geometry>
          <box>
            <size>0.07 0.07 0.07</size>
          </box>
        </geometry>
      </visual>


      <!-- ArUco marker mounted on one lateral side (+X face) -->
      <!-- Box visual for the marker -->
      <visual name="aruco_visual">
        <pose>0.0 0.0 0.035 0 0 0</pose>
        <geometry>
          <box>
            <size>0.07 0.07 0.001</size>
          </box>
        </geometry>
        <material>
          <script>
          <uri>model://aruco_marker_original_63/material/scripts</uri>
          <uri>model://aruco_marker_original_63/material/textures</uri>
                <name>Aruco/aruco_marker_original_63</name>
          </script>
        </material>
      </visual>

      <velocity_decay>
        <linear>0.000000</linear>
        <angular>0.000000</angular>
      </velocity_decay>
      <self_collide>0</self_collide>
      <kinematic>0</kinematic>
      <gravity>1</gravity>
    </link>
  </model>
</sdf>
